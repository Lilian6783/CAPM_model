import time

tickers = ["ALPHA", "GAMMA", "THETA"]
index = "RITM"

# Rules
fee = 0.02
max_order = 10_000
gross_limit = 250_000
net_limit = 100_000

# Settings
safety = 0.99
gross_cap = gross_limit * safety
net_cap = net_limit * safety
budget = net_cap
min_edge = 2 * fee
min_trade = 500
SEND_ORDERS = True
VERBOSE = True

# Memory between 2 ticks
old_targets = {}
_last_tick = None
_last_inputs = None
_last_missing = None
_tickers_checked = False

# Resetting pricing memory when a new simulation starts
def reset():
    global old_targets, _last_tick, _last_inputs, _last_missing, _tickers_checked
    old_targets = {}
    _last_tick = _last_inputs = _last_missing = None
    _tickers_checked = False
    print("[PRICING] Pricing memory is reset")

###################################################################################

# Calling news inputs
def read_inputs(state, tick):
    rf = state.get("rf")
    betas = state.get("beta", {})
    target_tick = state.get("target_tick")
    target_price = state.get("target_price")

    """ Printing missing info """
    missing = []
    if rf is None:
        missing.append("risk-free rate")
    if any(betas.get(t) is None for t in tickers):
        missing.append("betas")
    if target_tick is None or target_price is None:
        missing.append("RITM forecasts")
    if missing:
        return None, "missing inputs in news: " + ", ".join(missing)

    if target_tick <= tick:
        return None, (f"target tick {target_tick} already reached, "
                      f"waiting for a new forecast")

    return {"rf": rf, "betas": {t: betas[t] for t in tickers},
            "target_tick": target_tick, "target_price": target_price,
            "n": target_tick - tick}, None

# Requesting tickers index and tickers info
def get_market(client):
    data = client.get('/securities').json()
    if not isinstance(data, list):
        raise RuntimeError(f"Unexpected /securities response: {data}")
    out = {}
    for s in data:
        out[s.get("ticker")] = {"last": s.get("last"), "position": int(s.get("position") or 0)}
    for t in [index] + tickers:
        if t not in out or not out[t]["last"]:
            raise RuntimeError(f"Price unavailable for {t}: {out.get(t)}")
    return out



# CAPM pricing
def price_targets(inputs, market, log):
    rf, n = inputs["rf"], inputs["n"]
    ritm_now = market[index]["last"]

    """ Market yield per tick turning into target price in n ticks """
    rm = (inputs["target_price"] / ritm_now) ** (1 / n) - 1
    log(f"[PRICING] RITM={ritm_now} -> target {inputs['target_price']} at tick "
        f"{inputs['target_tick']} ({n} ticks)")
    log(f"[PRICING] rm/tick = ({inputs['target_price']} / {ritm_now})^(1/{n}) - 1 = {rm:.6f}")
    log(f"[PRICING] rf/tick = {rf:.6f} | risk premium (rm - rf) = {rm - rf:.6f}")

    res = {}
    for t in tickers:
        beta = inputs["betas"][t]
        last = market[t]["last"]
        exp_ret = rf + beta * (rm - rf)
        target = last * (1 + exp_ret) ** n
        res[t] = {"beta": beta, "last": last, "exp_ret": exp_ret, "target": target}
        log(f"[PRICING] {t}: E[R]/tick = {rf:.6f} + {beta} x ({rm:.6f} - {rf:.6f}) = {exp_ret:.6f}"
            f" | price {last} -> target price {target:.4f}")
    return res



# Comparison
def compare(res, log):
    edges = {}
    for t in tickers:
        new = res[t]["target"]
        last = res[t]["last"]
        old = old_targets.get(t)

        """ Comparing old target price vs. new target price """
        if old is None:
            log(f"[COMPARE] {t}: old target price = (first computation) | new = {new:.4f}")
        else:
            log(f"[COMPARE] {t}: old target price = {old:.4f} | new = {new:.4f} "
                f"| variation = {new - old:+.4f}")

        edge_cash = new - last
        edge_pct = new / last - 1
        """ Determining the recommended action """
        if edge_cash > min_edge:
            verdict = "undervalued -> BUY"
        elif edge_cash < -min_edge:
            verdict = "overvalued -> SELL"
        else:
            verdict = f"edge too small (< {min_edge:.2f}$ of fee) -> HOLD"
        log(f"[COMPARE] {t}: market price = {last} | target - market = {edge_cash:+.4f}$ "
            f"({edge_pct:+.2%}) | {verdict}")

        edges[t] = {"edge_cash": edge_cash, "edge_pct": edge_pct}
        """ The new price becomes the old price for the next tick """
        old_targets[t] = new
    return edges


# Position sizing
def position_sizing(edges, log):
    """ Sizing budget between tickers considering expected edge %"""
    desired = {t: 0 for t in tickers}
    active = {t: e for t, e in edges.items() if abs(e["edge_cash"]) > min_edge}
    total = sum(abs(e["edge_pct"]) for e in active.values())
    if not active or total == 0:
        log("[SIZING] Edge too small: no trade")
        return desired
    for t, e in active.items():
        w = abs(e["edge_pct"]) / total
        qty = int(budget * w)
        desired[t] = qty if e["edge_cash"] > 0 else -qty
        log(f"[SIZING] {t}: weight {w:.1%} x budget {budget:,.0f} -> recommended position {desired[t]:+,}")
    return desired



# Limits
def enforce_limits(desired, log):
    gross = sum(abs(v) for v in desired.values())
    net = sum(desired.values())
    log(f"[LIMITS] gross = {gross:,} (max {gross_limit:,}) | net = {net:+,} (max ±{net_limit:,})")
    factor = 1.0
    if gross > gross_cap:
        factor = min(factor, gross_cap / gross)
    if abs(net) > net_cap:
        factor = min(factor, net_cap / abs(net))
    if factor < 1:
        desired = {t: int(v * factor) for t, v in desired.items()}
        log(f"[LIMITS] WARNING Safety reached: position revised x{factor:.3f} : {desired}")
    else:
        log("[LIMITS] OK, limits not reached.")
    return desired



# Trading
def plan_trades(desired, positions, log):
    """Calcuting trades"""
    deltas = {}
    for t in tickers:
        d = desired[t] - positions[t]
        closing = desired[t] == 0 and positions[t] != 0
        if d != 0 and (abs(d) >= min_trade or closing):
            deltas[t] = d
        log(f"[TRADE] {t}: current positions {positions[t]:+,} => desired positions {desired[t]:+,} "
            f"| edge : {d:+,}" + ("" if t in deltas else "  (no trade)"))
    if not deltas:
        log("[TRADE] No trade to send.")

    """Sending trades reducing exposure"""
    ordered = sorted(deltas, key=lambda t: 0 if abs(positions[t] + deltas[t]) < abs(positions[t]) else 1)
    return deltas, ordered

def post_order(client, ticker, action, qty):
    """ Send one MARKET trade. If RIT refuses because of the volume, retry 3 times """
    params = {'ticker': ticker, 'type': 'MARKET', 'quantity': int(qty), 'action': action}
    resp = None
    for _ in range(3):
        resp = client.post("/orders", params=params).json()
        if isinstance(resp, dict) and "order_id" not in resp and resp.get("wait", 0) > 0:
            print(f"[TRADE]   debit limit, waiting for {resp['wait']} s puis nouvel essai")
            time.sleep(resp["wait"] + 0.01)
            continue
        break
    return resp

def execute_trades(client, deltas, ordered):
    """ Executing market trades sliced in blocks of max_order"""
    for t in ordered:
        d = deltas[t]
        action = "BUY" if d > 0 else "SELL"
        remaining = abs(d)
        while remaining > 0:
            qty = min(max_order, remaining)
            if SEND_ORDERS:
                resp = post_order(client, t, action, qty)
                if isinstance(resp, dict) and "order_id" in resp:
                    print(f"[TRADE] SENT {action} {qty:,} {t} (order_id {resp['order_id']})")
                else:
                    print(f"[TRADE] FAILED {action} {qty:,} {t} : {resp}")
            else:
                print(f"[TRADE] (SIMULATION, not sent) {action} {qty:,} {t}")
            remaining -= qty



# Orchestration
def update_and_trade(client, tick, state):
    global _last_tick, _last_inputs, _last_missing

    if tick == _last_tick:
        return
    _last_tick = tick

    inputs, missing = read_inputs(state, tick)
    if inputs is None:
        if missing != _last_missing:
            print(f"[PRICING] tick {tick}: {missing}")
            _last_missing = missing
        return
    _last_missing = None

    buf = []
    log = buf.append

    def flush():
        if buf:
            print("\n".join(buf))
            buf.clear()

    key = (inputs["rf"], tuple(inputs["betas"].items()), inputs["target_tick"], inputs["target_price"])
    changed = key != _last_inputs
    _last_inputs = key

    try:
        log(f"\n===== PRICING tick {tick} " + ("(new inputs) " if changed else "") + "=====")
        log(f"[DATA] rf={inputs['rf']:.6f} | betas={inputs['betas']} | "
            f" RITM target={inputs['target_price']} at tick {inputs['target_tick']}")

        market = get_market(client)
        res = price_targets(inputs, market, log)
        edges = compare(res, log)
        desired = position_sizing(edges, log)
        desired = enforce_limits(desired, log)
        positions = {t: market[t]["position"] for t in tickers}
        deltas, ordered = plan_trades(desired, positions, log)

        if VERBOSE or changed or deltas:
            flush()
        else:
            buf.clear()

        if deltas:
            execute_trades(client, deltas, ordered)          # ÉTAPE 7 (envoi)
            after = get_market(client)                       # ÉTAPE 8
            pos = {t: after[t]["position"] for t in tickers}
            print(f"[POSITIONS] after trades : {pos} | gross={sum(abs(v) for v in pos.values()):,} "
                  f"| net={sum(pos.values()):+,}")
    except Exception:
        flush()
        raise
