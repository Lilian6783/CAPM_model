
import time

tickers = ["ALPHA", "GAMMA", "THETA"]
index = "RITM"

#Rules
fee = 0.02
max_order = 10_000
gross_limit = 250_000
net_limit = 100_000

#Settings
safety = 0.99
gross_cap = gross_limit * safety
net_cap = net_limit * safety
budget = net_cap
min_edge = 2 * fee
min_trade = 500
SEND_ORDERS = True
VERBOSE = False

#Memory between 2 ticks
old_targets = {}
_last_tick = None
_last_inputs = None
_last_missing = None
_tickers_checked = False

#Resetting pricing memory when a new simulation starts
def reset():
    global old_targets, _last_tick, _last_inputs, _last_missing, _tickers_checked
    old_targets = {}
    _last_tick = _last_inputs = _last_missing = None
    _tickers_checked = False
    print("[PRICING] Pricing memory is reset")

###################################################################################

#Calling news inputs
def read_inputs(state, tick):
    rf = state.get("rf")
    betas = state.get("beta", {})
    target_tick = state.get("target_tick")
    target_price = state.get("target_price")

    """ Printing missing info """
    missing = []
    if rf is None:
        missing.append("risk-free rate")
    if any(betas.get(t) is None for t in tickers):
        missing.append("betas")
    if target_tick is None or target_price is None:
        missing.append("RITM forecasts")
    if missing:
        return None, "missing inputs in news: " + ", ".join(missing)

    if target_tick <= tick:
        return None, (f"target tick {target_tick} already reached (current tick {tick}), "
                      f"waiting for a new forecast")

    return {"rf": rf, "betas": {t: betas[t] for t in tickers},
            "target_tick": target_tick, "target_price": target_price,
            "n": target_tick - tick}, None



# Requesting tickers index and tickers info
def get_market(client):
    data = client.get('/securities').json()
    if not isinstance(data, list):
        raise RuntimeError(f"Réponse inattendue de /securities : {data}")
    out = {}
    for s in data:
        out[s.get("ticker")] = {"last": s.get("last"), "position": int(s.get("position") or 0)}
    for t in [index] + tickers:
        if t not in out or not out[t]["last"]:
            raise RuntimeError(f"Prix indisponible pour {t} : {out.get(t)}")
    return out


# ----------------------------------------------------------------------
# ÉTAPE 3 : pricing CAPM
# ----------------------------------------------------------------------
def price_targets(inputs, market, log):
    rf, n = inputs["rf"], inputs["n"]
    ritm_now = market[index]["last"]

    if rf > 0.01:
        log(f"[PRICING] ATTENTION : rf={rf} semble être en % et non en décimal par tick.")

    # rendement du marché par tick pour passer de RITM actuel au prix cible en n ticks
    rm = (inputs["target_price"] / ritm_now) ** (1 / n) - 1
    log(f"[PRICING] RITM={ritm_now} -> cible {inputs['target_price']} au tick "
        f"{inputs['target_tick']} ({n} ticks)")
    log(f"[PRICING] rm/tick = ({inputs['target_price']} / {ritm_now})^(1/{n}) - 1 = {rm:.6f}")
    log(f"[PRICING] rf/tick = {rf:.6f} | prime de marché (rm - rf) = {rm - rf:.6f}")

    res = {}
    for t in tickers:
        beta = inputs["betas"][t]
        last = market[t]["last"]
        exp_ret = rf + beta * (rm - rf)              # CAPM : E[R] = rf + beta x (rm - rf)
        target = last * (1 + exp_ret) ** n           # prix cible au tick cible
        res[t] = {"beta": beta, "last": last, "exp_ret": exp_ret, "target": target}
        log(f"[PRICING] {t}: E[R]/tick = {rf:.6f} + {beta} x ({rm:.6f} - {rf:.6f}) = {exp_ret:.6f}"
            f" | prix {last} -> prix cible {target:.4f}")
    return res


# ----------------------------------------------------------------------
# ÉTAPE 4 : comparaison (ancien prix cible, prix du marché)
# ----------------------------------------------------------------------
def compare(res, log):
    edges = {}
    for t in tickers:
        new = res[t]["target"]
        last = res[t]["last"]
        old = old_targets.get(t)

        if old is None:
            log(f"[COMPARE] {t}: ancien prix cible = (premier calcul) | nouveau = {new:.4f}")
        else:
            log(f"[COMPARE] {t}: ancien prix cible = {old:.4f} | nouveau = {new:.4f} "
                f"| variation = {new - old:+.4f}")

        edge_cash = new - last
        edge_pct = new / last - 1
        if edge_cash > min_edge:
            verdict = "undervalued -> BUY"
        elif edge_cash < -min_edge:
            verdict = "overvalued -> SELL"
        else:
            verdict = f"écart trop faible (< {min_edge:.2f}$ de frais) -> NEUTRE"
        log(f"[COMPARE] {t}: prix marché = {last} | cible - marché = {edge_cash:+.4f}$ "
            f"({edge_pct:+.2%}) | {verdict}")

        edges[t] = {"edge_cash": edge_cash, "edge_pct": edge_pct}
        old_targets[t] = new          # le nouveau devient l'ancien pour le prochain tick
    return edges


# ----------------------------------------------------------------------
# ÉTAPE 5 : sizing
# ----------------------------------------------------------------------
def size_positions(edges, log):
    """Répartit BUDGET actions entre les titres au prorata de l'écart attendu (en %)."""
    desired = {t: 0 for t in tickers}
    active = {t: e for t, e in edges.items() if abs(e["edge_cash"]) > min_edge}
    total = sum(abs(e["edge_pct"]) for e in active.values())
    if not active or total == 0:
        log("[SIZING] Aucun titre avec un écart suffisant -> positions cibles = 0")
        return desired
    for t, e in active.items():
        w = abs(e["edge_pct"]) / total
        qty = int(budget * w)
        desired[t] = qty if e["edge_cash"] > 0 else -qty
        log(f"[SIZING] {t}: poids {w:.1%} x budget {budget:,.0f} -> position souhaitée {desired[t]:+,}")
    return desired


# ----------------------------------------------------------------------
# ÉTAPE 6 : limites
# ----------------------------------------------------------------------
def enforce_limits(desired, log):
    gross = sum(abs(v) for v in desired.values())
    net = sum(desired.values())
    log(f"[LIMITES] brute = {gross:,} (max {gross_limit:,}) | nette = {net:+,} (max ±{net_limit:,})")
    factor = 1.0
    if gross > gross_cap:
        factor = min(factor, gross_cap / gross)
    if abs(net) > net_cap:
        factor = min(factor, net_cap / abs(net))
    if factor < 1:
        desired = {t: int(v * factor) for t, v in desired.items()}
        log(f"[LIMITES] Dépassement de la marge de sécurité -> positions réduites x{factor:.3f} : {desired}")
    else:
        log("[LIMITES] OK, dans les limites.")
    return desired


# ----------------------------------------------------------------------
# ÉTAPE 7 : trades (plan puis exécution)
# ----------------------------------------------------------------------
def plan_trades(desired, positions, log):
    """Calcule les ordres à passer. Retourne (deltas, ordre_d_envoi)."""
    deltas = {}
    for t in tickers:
        d = desired[t] - positions[t]
        closing = desired[t] == 0 and positions[t] != 0
        if d != 0 and (abs(d) >= min_trade or closing):
            deltas[t] = d
        log(f"[TRADE] {t}: position actuelle {positions[t]:+,} -> souhaitée {desired[t]:+,} "
            f"| écart : {d:+,}" + ("" if t in deltas else "  (aucun ordre)"))
    if not deltas:
        log("[TRADE] Aucun ordre à envoyer.")
    # on envoie d'abord les ordres qui RÉDUISENT l'exposition (évite de dépasser les limites)
    ordered = sorted(deltas, key=lambda t: 0 if abs(positions[t] + deltas[t]) < abs(positions[t]) else 1)
    return deltas, ordered


def post_order(client, ticker, action, qty):
    params = {'ticker': ticker, 'type': 'MARKET', 'quantity': int(qty), 'action': action}
    resp = None
    for _ in range(3):
        resp = client.post("/orders", params=params).json()
        if isinstance(resp, dict) and "order_id" not in resp and resp.get("wait", 0) > 0:
            print(f"[TRADE]   limite de débit, attente de {resp['wait']} s puis nouvel essai")
            time.sleep(resp["wait"] + 0.01)
            continue
        break
    return resp


def execute_trades(client, deltas, ordered):
    """Envoie les ordres MARKET, découpés en blocs de MAX_ORDER actions."""
    for t in ordered:
        d = deltas[t]
        action = "BUY" if d > 0 else "SELL"
        remaining = abs(d)
        while remaining > 0:
            qty = min(max_order, remaining)
            if SEND_ORDERS:
                resp = post_order(client, t, action, qty)
                if isinstance(resp, dict) and "order_id" in resp:
                    print(f"[TRADE] ENVOYÉ {action} {qty:,} {t} (order_id {resp['order_id']})")
                else:
                    print(f"[TRADE] ÉCHEC {action} {qty:,} {t} : {resp}")
            else:
                print(f"[TRADE] (SIMULATION, non envoyé) {action} {qty:,} {t}")
            remaining -= qty


# ----------------------------------------------------------------------
# ORCHESTRATION (une fois par tick)
# ----------------------------------------------------------------------
def update_and_trade(client, tick, state):
    global _last_tick, _last_inputs, _last_missing

    if tick == _last_tick:
        return
    _last_tick = tick

    # ÉTAPE 1 : données des nouvelles
    inputs, missing = read_inputs(state, tick)
    if inputs is None:
        if missing != _last_missing:                 # message affiché seulement quand il change
            print(f"[PRICING] tick {tick}: {missing}")
            _last_missing = missing
        return
    _last_missing = None

    buf = []
    log = buf.append

    def flush():
        if buf:
            print("\n".join(buf))
            buf.clear()

    key = (inputs["rf"], tuple(inputs["betas"].items()), inputs["target_tick"], inputs["target_price"])
    changed = key != _last_inputs
    _last_inputs = key

    try:
        log(f"\n===== PRICING tick {tick} " + ("(nouvelles données) " if changed else "") + "=====")
        log(f"[DONNÉES] rf={inputs['rf']:.6f} | bêtas={inputs['betas']} | "
            f"cible RITM={inputs['target_price']} au tick {inputs['target_tick']}")

        market = get_market(client)                          # ÉTAPE 2
        res = price_targets(inputs, market, log)             # ÉTAPE 3
        edges = compare(res, log)                            # ÉTAPE 4
        desired = size_positions(edges, log)                 # ÉTAPE 5
        desired = enforce_limits(desired, log)               # ÉTAPE 6
        positions = {t: market[t]["position"] for t in tickers}
        deltas, ordered = plan_trades(desired, positions, log)   # ÉTAPE 7 (plan)

        # on affiche tout le détail si VERBOSE, si les données ont changé ou s'il y a des ordres
        if VERBOSE or changed or deltas:
            flush()
        else:
            buf.clear()

        if deltas:
            execute_trades(client, deltas, ordered)          # ÉTAPE 7 (envoi)
            after = get_market(client)                       # ÉTAPE 8
            pos = {t: after[t]["position"] for t in tickers}
            print(f"[POSITIONS] après trades : {pos} | brute={sum(abs(v) for v in pos.values()):,} "
                  f"| nette={sum(pos.values()):+,}")
    except Exception:
        flush()          # on montre ce qui a été calculé avant l'erreur
        raise
