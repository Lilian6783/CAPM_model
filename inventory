
import time

#Setup
TICKERS = ["ALPHA", "GAMMA", "THETA"]
INDEX = "RITM"

GROSS_LIMIT = 250_000
NET_LIMIT = 100_000
SAFETY = 0.90                                
GROSS_INT = int(GROSS_LIMIT * SAFETY)       
NET_INT = int(NET_LIMIT * SAFETY)            

MAX_ORDER = 10_000                           
FEE = 0.02                                   
ROUND_TRIP_FEE = 2 * FEE
DEAD_BAND = 500                              
MIN_CHUNK = 100                              
UNWIND_TICKS = 2                             
MAX_PASSES = 40                              


#Info queries
def get_securities(client):
    return {s["ticker"]: s for s in client.get("/securities").json()}


def get_positions(client):
    secs = get_securities(client)
    return {t: int(secs[t]["position"]) for t in TICKERS}


def gross_net(pos):
    """(brute, nette) : brute = somme des |positions|, nette = somme signée."""
    return sum(abs(v) for v in pos.values()), sum(pos.values())


# Trades
def send_market_order(client, ticker, signed_qty):
    """signed_qty > 0 = buy, < 0 = sell. Return True if trade accepted"""
    qty = abs(int(signed_qty))
    if qty == 0:
        return False
    r = client.post("/orders", params={"ticker": ticker, "type": "MARKET", "quantity": qty, "action": "BUY" if signed_qty > 0 else "SELL"})
    if not r.is_success:
        print(f"trade denied {ticker} {signed_qty}: {r.status_code} {r.text}")
    return r.is_success


#Inventory management
def trade_allowed(pos, ticker, signed_qty):
    """ pretrade verification """
    g0, n0 = gross_net(pos)
    new = dict(pos)
    new[ticker] += signed_qty
    g1, n1 = gross_net(new)

    reduces = g1 <= g0 and abs(n1) <= abs(n0)
    within = g1 <= GROSS_INT and abs(n1) <= NET_INT
    return reduces or within


def emergency_check(client):
    """ reached limit notification """
    pos = get_positions(client)
    g, n = gross_net(pos)
    if g <= GROSS_INT and abs(n) <= NET_INT:
        return False

    print(f"Warning limit reached: gross={g}, net={n} -> you must reduce your positions")

    if abs(n) > NET_INT:
        # Curb the greatest active position
        sign = 1 if n > 0 else -1
        candidates = {t: v for t, v in pos.items() if v * sign > 0}
        t = max(candidates, key=lambda k: abs(candidates[k]))
        excess = abs(n) - NET_INT
    else:
        t = max(pos, key=lambda k: abs(pos[k]))
        excess = g - GROSS_INT

    qty = min(MAX_ORDER, abs(pos[t]), excess)
    return send_market_order(client, t, -qty if pos[t] > 0 else qty)


