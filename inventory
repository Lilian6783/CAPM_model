# ----------------------------- EXÉCUTION ------------------------------------
def execute_towards(client, targets):
    """Amène les positions vers les cibles.

    On fait plusieurs passes : à chaque passe, UNE tranche (<= 10 000) par titre,
    ordres réducteurs d'abord. Ainsi les achats et les ventes s'alternent et les
    limites nette / brute ne bloquent pas un titre en attendant l'autre."""
    pos = get_positions(client)

    for _ in range(MAX_PASSES):
        # Titres qui ont encore un écart significatif (ou à fermer à zéro)
        diffs = {}
        for t in TICKERS:
            d = targets[t] - pos[t]
            closing = targets[t] == 0 and pos[t] != 0
            if abs(d) >= DEAD_BAND or closing:
                diffs[t] = d
        if not diffs:
            break

        # Réduire d'abord (libère de la capacité), augmenter ensuite
        order = sorted(diffs, key=lambda t: abs(pos[t] + diffs[t]) >= abs(pos[t]))

        progressed = False
        for t in order:
            remaining = targets[t] - pos[t]
            if remaining == 0:
                continue
            sign = 1 if remaining > 0 else -1
            chunk = min(abs(remaining), MAX_ORDER)

            # Réduire la tranche jusqu'à passer le test pré-trade
            while chunk > 0 and not trade_allowed(pos, t, sign * chunk):
                chunk //= 2
            if chunk == 0:
                continue
            if chunk < MIN_CHUNK and abs(remaining) >= MIN_CHUNK:
                continue                      # tranche trop petite pour valoir les frais

            if not send_market_order(client, t, sign * chunk):
                continue
            time.sleep(0.05)

            new_pos = get_positions(client)   # re-valider la position réelle
            if new_pos[t] != pos[t]:
                progressed = True
            pos = new_pos

        if not progressed:
            break


# ----------------------------- POINT D'ENTRÉE POUR MAIN ---------------------
def rebalance(client, tick, state):
    """Un appel par tick : calcule les cibles puis exécute.
    Retourne les cibles, ou None si on n'a pas encore de prévision."""
    if state["target_tick"] is None:
        return None

    secs = get_securities(client)

    if tick >= state["target_tick"]:
        targets = {t: 0 for t in TICKERS}             # prévision expirée : à plat
    else:
        prices = {t: secs[t]["last"] for t in TICKERS + [INDEX]}
        targets = compute_targets(tick, state, prices)

    print(f"[tick {tick}] cibles: {targets}")
    execute_towards(client, targets)
    return targets
