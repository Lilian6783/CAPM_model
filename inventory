"""
inventory.py - Position (inventory) management for the CAPM case.

Role:
  - read the actual positions
  - compute target positions (linear program) under INTERNAL limits
  - execute in chunks <= 10,000 with a pre-trade check
  - safety net if we get close to the gross / net limits

Every function receives the httpx `client` from main.py.
Dependency for compute_targets: pip install scipy
"""
import time

# ----------------------------- CONFIG ---------------------------------------
TICKERS = ["ALPHA", "GAMMA", "THETA"]
INDEX = "RITM"

GROSS_LIMIT = 250_000
NET_LIMIT = 100_000
SAFETY = 0.90                                # safety cushion
GROSS_INT = int(GROSS_LIMIT * SAFETY)        # 225,000
NET_INT = int(NET_LIMIT * SAFETY)            # 90,000

MAX_ORDER = 10_000                           # max size per transaction
FEE = 0.02                                   # $ per share, per transaction
ROUND_TRIP_FEE = 2 * FEE
DEAD_BAND = 500                              # ignore gaps < 500 shares
MIN_CHUNK = 100                              # smallest chunk after shrinking
UNWIND_TICKS = 2                             # start unwinding 2 ticks before the target
MAX_PASSES = 40                              # safety against infinite loops


# ----------------------------- INFO QUERIES ---------------------------------
def get_securities(client):
    return {s["ticker"]: s for s in client.get("/securities").json()}


def get_positions(client):
    secs = get_securities(client)
    return {t: int(secs[t]["position"]) for t in TICKERS}


def gross_net(pos):
    """(gross, net): gross = sum of |positions|, net = signed sum."""
    return sum(abs(v) for v in pos.values()), sum(pos.values())


# ----------------------------- TRADES ---------------------------------------
def send_market_order(client, ticker, signed_qty):
    """signed_qty > 0 = buy, < 0 = sell. Returns True if the order is accepted."""
    qty = abs(int(signed_qty))
    if qty == 0:
        return False
    r = client.post("/orders", params={
        "ticker": ticker,
        "type": "MARKET",
        "quantity": qty,
        "action": "BUY" if signed_qty > 0 else "SELL",
    })
    if r.is_success:
        print(f"   order sent: {'BUY' if signed_qty > 0 else 'SELL'} {qty} {ticker}")
    else:
        print(f"   ORDER DENIED {ticker} {signed_qty}: {r.status_code} {r.text}")
    return r.is_success


# ----------------------------- SAFEGUARDS -----------------------------------
def trade_allowed(pos, ticker, signed_qty):
    """Pre-trade check: stay within the internal limits,
    or the order reduces risk (always allowed)."""
    g0, n0 = gross_net(pos)
    new = dict(pos)
    new[ticker] += signed_qty
    g1, n1 = gross_net(new)

    reduces = g1 <= g0 and abs(n1) <= abs(n0)
    within = g1 <= GROSS_INT and abs(n1) <= NET_INT
    return reduces or within


def emergency_check(client):
    """Safety net: if the internal limits are exceeded, reduce exactly the excess.
    Returns True if a reduction order was sent."""
    pos = get_positions(client)
    g, n = gross_net(pos)
    if g <= GROSS_INT and abs(n) <= NET_INT:
        return False

    print(f"Warning limit reached: gross={g}, net={n} -> reducing positions")

    if abs(n) > NET_INT:
        # Reduce the largest position on the side that creates the net excess
        sign = 1 if n > 0 else -1
        candidates = {t: v for t, v in pos.items() if v * sign > 0}
        t = max(candidates, key=lambda k: abs(candidates[k]))
        excess = abs(n) - NET_INT
    else:
        t = max(pos, key=lambda k: abs(pos[k]))
        excess = g - GROSS_INT

    qty = min(MAX_ORDER, abs(pos[t]), excess)
    return send_market_order(client, t, -qty if pos[t] > 0 else qty)


# ----------------------------- TARGET POSITIONS -----------------------------
def compute_targets(tick, state, prices):
    """Target positions (shares) that maximize expected net profit under the
    internal limits.

    state : dict from news_section (keys rf, beta, target_tick, target_price)
    prices: {"RITM": ..., "ALPHA": ..., "GAMMA": ..., "THETA": ...} (last prices)
    """
    flat = {t: 0 for t in TICKERS}

    n = state["target_tick"] - tick
    if n <= UNWIND_TICKS or state["rf"] is None:
        return flat
    if any(t not in state["beta"] for t in TICKERS):
        return flat
    if not prices.get(INDEX) or any(not prices.get(t) for t in TICKERS):
        return flat

    from scipy.optimize import linprog

    rm_h = state["target_price"] / prices[INDEX] - 1.0   # RITM return over the horizon
    rf_h = state["rf"] * n                                # risk-free over the horizon

    # Expected profit per share ($): price * E[Ri], E[Ri] = rf + beta * (rm - rf)
    c = []
    for t in TICKERS:
        er = rf_h + state["beta"][t] * (rm_h - rf_h)
        c.append(prices[t] * er)

    # Variables: [long_A, long_G, long_T, short_A, short_G, short_T] >= 0
    k = len(TICKERS)
    obj = [-(ci - ROUND_TRIP_FEE) for ci in c] + [-(-ci - ROUND_TRIP_FEE) for ci in c]

    A_ub = [
        [1] * (2 * k),                 # gross: sum(long + short) <= GROSS_INT
        [1] * k + [-1] * k,            # net: long - short <= NET_INT
        [-1] * k + [1] * k,            # net: short - long <= NET_INT
    ]
    b_ub = [GROSS_INT, NET_INT, NET_INT]
    bounds = [(0, GROSS_INT)] * (2 * k)

    res = linprog(obj, A_ub=A_ub, b_ub=b_ub, bounds=bounds, method="highs")
    if not res.success:
        return flat

    x = res.x
    return {t: int(x[i] - x[i + k]) for i, t in enumerate(TICKERS)}  # int() truncates toward 0


# ----------------------------- EXECUTION ------------------------------------
def wait_for_position(client, ticker, old_value, tries=6, delay=0.1):
    """Market orders may take a moment to show up in the position.
    Polls a few times; returns the latest positions."""
    pos = get_positions(client)
    for _ in range(tries):
        if pos[ticker] != old_value:
            break
        time.sleep(delay)
        pos = get_positions(client)
    return pos


def execute_towards(client, targets):
    """Moves the positions toward the targets.

    Several passes: on each pass, ONE chunk (<= 10,000) per ticker,
    risk-reducing orders first. Buys and sells therefore alternate, and the
    net / gross limits don't block one ticker while waiting for another."""
    pos = get_positions(client)
    print(f"   current positions: {pos}")

    for _ in range(MAX_PASSES):
        # Tickers that still have a significant gap (or must be closed to zero)
        diffs = {}
        for t in TICKERS:
            d = targets[t] - pos[t]
            closing = targets[t] == 0 and pos[t] != 0
            if abs(d) >= DEAD_BAND or closing:
                diffs[t] = d
        if not diffs:
            print("   done: positions at targets (or within the dead band)")
            break

        # Reduce first (frees up capacity), then increase
        order = sorted(diffs, key=lambda t: abs(pos[t] + diffs[t]) >= abs(pos[t]))

        progressed = False
        for t in order:
            remaining = targets[t] - pos[t]
            if remaining == 0:
                continue
            sign = 1 if remaining > 0 else -1
            chunk = min(abs(remaining), MAX_ORDER)

            # Shrink the chunk until it passes the pre-trade check
            while chunk > 0 and not trade_allowed(pos, t, sign * chunk):
                chunk //= 2
            if chunk == 0:
                print(f"   {t}: blocked by the pre-trade check (limits)")
                continue
            if chunk < MIN_CHUNK and abs(remaining) >= MIN_CHUNK:
                print(f"   {t}: chunk {chunk} too small, skipped")
                continue

            if not send_market_order(client, t, sign * chunk):
                continue

            new_pos = wait_for_position(client, t, pos[t])   # re-validate the real position
            if new_pos[t] != pos[t]:
                progressed = True
            else:
                print(f"   WARNING: {t} position did not change after the order")
            pos = new_pos

        if not progressed:
            break


# ----------------------------- ENTRY POINT FOR MAIN -------------------------
def rebalance(client, tick, state):
    """One call per tick: computes the targets, then executes.
    Returns the targets, or None if there is no forecast yet."""
    if state["target_tick"] is None:
        print(f"[tick {tick}] no forecast received yet -> no trading")
        return None

    secs = get_securities(client)

    if tick >= state["target_tick"]:
        targets = {t: 0 for t in TICKERS}             # forecast expired: go flat
    else:
        prices = {t: secs[t]["last"] for t in TICKERS + [INDEX]}
        targets = compute_targets(tick, state, prices)

    print(f"[tick {tick}] targets: {targets}")
    execute_towards(client, targets)
    return targets
