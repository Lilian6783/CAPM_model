import os
import sys
import time
import httpx


sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import news as news

TICKERS = ["ALPHA", "GAMMA", "THETA"]


def get_last(client, ticker):
    resp = client.get('/securities', params={'ticker': ticker}).json()
    return resp[0].get('last')


def main(client):
    state = news.new_state()
    last_printed_tick = None

    while True:
        tick = client.get('/case').json().get('tick')

        # commencer un peu après le début et finir un peu avant la fin
        if 1 < tick < 599:

            # 1) Lire les nouvelles (met à jour state)
            if news.read_news(client, state):
                print(f"[tick {tick}] state mis à jour : {state}")

            # 2) Agir seulement si on a les bêtas, rf et une prévision à venir
            ready = (
                state["rf"] is not None
                and len(state["beta"]) == len(TICKERS)
                and state["target_tick"] is not None
                and state["target_tick"] > tick
            )

            if ready and tick != last_printed_tick:
                last_printed_tick = tick   # un seul affichage par tick

                ritm_now = get_last(client, "RITM")
                n = state["target_tick"] - tick
                rm = (state["target_price"] / ritm_now) ** (1 / n) - 1  # rendement par tick

                print(f"[tick {tick}] RITM={ritm_now}, cible={state['target_price']} "
                      f"au tick {state['target_tick']}, rm/tick={rm:.6f}")

                rf = state["rf"]
                print(f"   rf/tick={rf:.6f}, prime de marché (rm - rf)={rm - rf:.6f}")

                for t in TICKERS:
                    beta = state["beta"][t]
                    exp_ret = news.get_exp_return(state, t, rm)
                    last = get_last(client, t)

                    # Vérification manuelle de la formule, indépendante de la fonction
                    check = rf + beta * (rm - rf)
                    ok = "OK" if abs(check - exp_ret) < 1e-12 else "ERREUR"

                    # Rendement cumulé attendu jusqu'au tick cible et prix implicite
                    exp_total = (1 + exp_ret) ** n - 1
                    implied_price = last * (1 + exp_ret) ** n

                    print(f"   {t}: prix={last}, beta={beta}")
                    print(f"      E[R]/tick = {rf:.6f} + {beta} x ({rm:.6f} - {rf:.6f}) "
                          f"= {exp_ret:.6f} [{ok}]")
                    print(f"      sur {n} ticks : rendement attendu={exp_total:.2%}, "
                          f"prix implicite au tick {state['target_tick']}={implied_price:.2f}")

        time.sleep(0.2)


if __name__ == "__main__":
    API_KEY = "VZETG60P"
    API_PORT = 9999
    url = f"http://localhost:{API_PORT}/v1"
    params = {'key': API_KEY}

    with httpx.Client(base_url=url, params=params) as client:
        main(client)
