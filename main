import os
import sys
import time
import httpx

# Lets Python import news.py and inventory.py even if the script is launched from another folder
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import news
import inventory

TICKERS = ["ALPHA", "GAMMA", "THETA"]


def get_last(client, ticker):
    resp = client.get('/securities', params={'ticker': ticker}).json()
    return resp[0].get('last')


def main(client):
    state = news.new_state()
    last_printed_tick = None

    while True:
        tick = client.get('/case').json().get('tick')

        # start a bit after the beginning and stop a bit before the end
        if 1 < tick < 599:

            # 1) Read the news (updates state)
            if news.read_news(client, state):
                print(f"[tick {tick}] state updated: {state}")

            # 2) Act only if we have the betas, rf and an upcoming forecast
            ready = (
                state["rf"] is not None
                and len(state["beta"]) == len(TICKERS)
                and state["target_tick"] is not None
                and state["target_tick"] > tick
            )

            if ready and tick != last_printed_tick:
                last_printed_tick = tick   # print only once per tick

                ritm_now = get_last(client, "RITM")
                n = state["target_tick"] - tick
                rm = (state["target_price"] / ritm_now) ** (1 / n) - 1  # return per tick

                print(f"[tick {tick}] RITM={ritm_now}, target={state['target_price']} "
                      f"at tick {state['target_tick']}, rm/tick={rm:.6f}")

                rf = state["rf"]
                print(f"   rf/tick={rf:.6f}, market premium (rm - rf)={rm - rf:.6f}")

                for t in TICKERS:
                    beta = state["beta"][t]
                    exp_ret = news.get_exp_return(state, t, rm)
                    last = get_last(client, t)

                    # Manual check of the formula, independent of the function
                    check = rf + beta * (rm - rf)
                    ok = "OK" if abs(check - exp_ret) < 1e-12 else "ERROR"

                    # Expected cumulative return up to the target tick, and implied price
                    exp_total = (1 + exp_ret) ** n - 1
                    implied_price = last * (1 + exp_ret) ** n

                    print(f"   {t}: price={last}, beta={beta}")
                    print(f"      E[R]/tick = {rf:.6f} + {beta} x ({rm:.6f} - {rf:.6f}) "
                          f"= {exp_ret:.6f} [{ok}]")
                    print(f"      over {n} ticks: expected return={exp_total:.2%}, "
                          f"implied price at tick {state['target_tick']}={implied_price:.2f}")

        time.sleep(0.2)


if __name__ == "__main__":
    API_KEY = "VZETG60P"
    API_PORT = 9999
    url = f"http://localhost:{API_PORT}/v1"
    params = {'key': API_KEY}

    with httpx.Client(base_url=url, params=params) as client:
        main(client)
