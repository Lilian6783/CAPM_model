"""
main.py : point d'entrée. Se connecte au serveur RIT et appelle news.py.

Lancer :  python main.py
"""
import time
import httpx

import news   # <- lien avec news.py (variables accessibles via news.betas, news.rf, ...)

"""
information pour le serveur lors du cours
server:10.6.32.193
port:10000

information pour le serveur de pratique
server:rit.fsa.ulaval.ca
port:100__
"""
API_KEY = "3KOTDBQX"
API_PORT = 10000 + 1
URL = f"http://localhost:{API_PORT}/v1"


def main(client):
    print("Analyse des nouvelles CAPM en cours...")
    news.reset_news_reader()
    last_tick = None

    while True:
        case = client.get('/case').json()
        tick = case.get('tick')

        if tick != last_tick:
            print(f"[TICK] tick = {tick} | status = {case.get('status')}")
            last_tick = tick

        # Lit et affiche les nouvelles ; met à jour les variables de news.py
        if news.read_news(client):
            # Exemple d'accès aux variables depuis main :
            print(f"[MAIN] betas={news.betas} | rf={news.rf} | "
                  f"cible: tick {news.target_tick} -> {news.ritm_prix_prevu}")

        time.sleep(0.5)


if __name__ == "__main__":
    with httpx.Client(base_url=URL, params={'key': API_KEY}) as client:
        main(client)
