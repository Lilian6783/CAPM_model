import re

# IDs des nouvelles déjà lues (évite de retraiter la même nouvelle)
old_ids = set()


def new_state():
    """État initial partagé entre main et ce module."""
    return {
        "rf": None,            # taux sans risque par tick (ex: 0.000107)
        "beta": {},            # {"ALPHA": 1.3, "GAMMA": 1.46, "THETA": 2.3}
        "target_tick": None,   # tick où RITM atteindra le prix prévu
        "target_price": None,  # prix prévu de RITM
    }


def get_all_news(client):
    return client.get('/news', params={'limit': 50}).json()


def parse_news(text):
    """Extrait ce que contient une nouvelle. Retourne un dict (vide si rien)."""
    out = {}

    # Première nouvelle : bêtas + taux sans risque
    if "historical beta" in text:
        out["beta"] = {
            t.upper(): float(v)
            for t, v in re.findall(
                r"(Alpha|Gamma|Theta) historical beta is\s*:\s*(\d+(?:\.\d+)?)", text
            )
        }
        m = re.search(r"risk free is\s*:\s*(\d+(?:\.\d+)?)\s*%", text)
        if m:
            out["rf"] = float(m.group(1)) / 100   # 0.0107% -> 0.000107

    # Nouvelles de prévision : tick cible + prix prévu
    m = re.search(r"at tick (\d+).*?\$\s*([\d,]+(?:\.\d+)?)", text)
    if m:
        out["target_tick"] = int(m.group(1))
        out["target_price"] = float(m.group(2).replace(",", ""))

    return out


def read_news(client, state, debug=True):
    """Lit les nouvelles non lues et met à jour state.
    Retourne True si au moins une nouvelle a changé l'état."""
    changed = False
    items = sorted(get_all_news(client), key=lambda x: x["news_id"])  # ancienne -> récente

    for item in items:
        if item["news_id"] in old_ids:
            continue
        old_ids.add(item["news_id"])

        text = item.get("headline", "") + " " + item.get("body", "")
        data = parse_news(text)

        if debug:
            print(f"NOUVELLE #{item['news_id']}: {item.get('body')} -> {data}")

        if not data:
            continue

        state["beta"].update(data.pop("beta", {}))
        state.update(data)
        changed = True

    return changed


def get_exp_return(state, ticker, rm):
    """CAPM : E[Ri] = Rf + beta * (Rm - Rf)."""
    return state["rf"] + state["beta"][ticker] * (rm - state["rf"])


def get_alpha(state, ticker, rm, y_observed):
    """Écart entre le rendement observé et le rendement espéré."""
    return y_observed - get_exp_return(state, ticker, rm)
