import re

old_ids = set()

def new_state():
    return {"rf": None, "beta": {}, "target_tick": None, "target_price": None}

def get_all_news(client):
    return client.get('/news', params={'limit': 50}).json()

def parse_news(text):
    """Retourne un dict avec ce que la nouvelle contient."""
    out = {}

    if "historical beta" in text:
        out["beta"] = {
            t.upper(): float(v)
            for t, v in re.findall(r"(Alpha|Gamma|Theta) historical beta is\s*:\s*([\d.]+)", text)
        }
        m = re.search(r"risk free is\s*:\s*([\d.]+)\s*%", text)
        if m:
            out["rf"] = float(m.group(1)) / 100   # 0.0107% -> 0.000107

    m = re.search(r"at tick (\d+).*?\$\s*([\d,]+(?:\.\d+)?)", text)
    if m:
        out["target_tick"] = int(m.group(1))
        out["target_price"] = float(m.group(2).replace(",", ""))

    return out

def read_news(client, state):
    """Lit les nouvelles non lues et met à jour state. Retourne True si changement."""
    changed = False
    for item in reversed(get_all_news(client)):      # plus ancienne -> plus récente
        if item["news_id"] in old_ids:
            continue
        old_ids.add(item["news_id"])

        data = parse_news(item.get("headline", "") + " " + item.get("body", ""))
        if not data:
            continue

        state["beta"].update(data.pop("beta", {}))
        state.update(data)
        changed = True
    return changed

def get_exp_return(state, ticker, rm):
    return state["rf"] + state["beta"][ticker] * (rm - state["rf"])
