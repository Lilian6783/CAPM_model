
import re
import unicodedata

# IDs of news items already processed
old_ids = set()


def reset():
    old_ids.clear()


def new_state():
    return {
        "rf": None,
        "beta": {},
        "target_tick": None,
        "target_price": None,
    }


def get_all_news(client):
    response = client.get("/news", params={"limit": 50})
    response.raise_for_status()
    data = response.json()
    return data if isinstance(data, list) else []


# --------------------------------------------------
# BETA EXTRACTION
# --------------------------------------------------

def extract_beta(text, ticker):
    """
    Extracts one beta independently.
    Supports line breaks, multiple spaces and decimal commas.
    """
    pattern = (
        rf"\b{ticker}\b\s+"
        rf"(?:historical\s+)?beta\s+is\s*:?\s*"
        rf"([-+]?\d+(?:[.,]\d+)?)"
    )

    match = re.search(pattern, text, re.IGNORECASE)

    if match:
        return float(match.group(1).replace(",", "."))

    return None


def parse_betas(text):
    """Extracts the three betas independently."""

    betas = {}

    for ticker in ["ALPHA", "GAMMA", "THETA"]:

        value = extract_beta(text, ticker)

        if value is not None:
            betas[ticker] = value

    return betas


# --------------------------------------------------
# RISK-FREE RATE
# --------------------------------------------------

def parse_rf(text):

    pattern = (
        r"(?:historical\s+)?risk[\s-]*free\s+"
        r"is\s*:?\s*(\d+(?:[.,]\d+)?)\s*%"
    )

    match = re.search(pattern, text, re.IGNORECASE)

    if match:
        return float(match.group(1).replace(",", ".")) / 100

    return None


# --------------------------------------------------
# FORECAST EXTRACTION
# --------------------------------------------------

def parse_forecast(text):

    pattern = (
        r"at\s+tick\s+(\d+).*?"
        r"\$\s*([\d,]+(?:\.\d+)?)"
    )

    match = re.search(
        pattern,
        text,
        re.IGNORECASE | re.DOTALL
    )

    if match:
        return {
            "target_tick": int(match.group(1)),
            "target_price": float(match.group(2).replace(",", ""))
        }

    return {}


# --------------------------------------------------
# MAIN PARSER
# --------------------------------------------------

def parse_news(text):

    # Normalize text (line breaks, tabs, special spaces)
    text = unicodedata.normalize("NFKC", str(text))
    text = re.sub(r"\s+", " ", text).strip()

    out = {}

    # Extract betas
    betas = parse_betas(text)

    if betas:
        out["beta"] = betas

    # Extract risk-free rate
    rf = parse_rf(text)

    if rf is not None:
        out["rf"] = rf

    # Extract market forecast
    forecast = parse_forecast(text)
    out.update(forecast)

    return out


# --------------------------------------------------
# DISPLAY
# --------------------------------------------------

def print_news(item, data):

    print("\n" + "=" * 70)
    print(f"NEWS #{item.get('news_id')} | tick {item.get('tick')}")
    print(f"Headline: {item.get('headline')}")
    print(f"Body: {item.get('body')}")
    print(f"Parsed: {data if data else 'Nothing extracted'}")
    print("=" * 70)


# --------------------------------------------------
# READING NEWS AND UPDATING STATE
# --------------------------------------------------

def read_news(client, state, debug=True):

    changed = False

    items = sorted(
        get_all_news(client),
        key=lambda x: x.get("news_id", 0)
    )

    for item in items:

        news_id = item.get("news_id")

        if news_id is None or news_id in old_ids:
            continue

        text = (
            str(item.get("headline") or "")
            + " "
            + str(item.get("body") or "")
        )

        # Parse news
        data = parse_news(text)

        if debug:
            print_news(item, data)

            print("[DEBUG] Raw text:", repr(text))
            print("[DEBUG] Extracted betas:", data.get("beta", {}))

        # Update beta independently
        if "beta" in data:
            state["beta"].update(data["beta"])
            changed = True

        # Update risk-free rate
        if "rf" in data:
            state["rf"] = data["rf"]
            changed = True

        # Update forecasts
        if "target_tick" in data:
            state["target_tick"] = data["target_tick"]
            state["target_price"] = data["target_price"]
            changed = True

        # Mark as processed only after parsing
        old_ids.add(news_id)

        if debug:
            print("[DEBUG] Updated state:", state)

    return changed


def show_all_news(client):

    items = sorted(
        get_all_news(client),
        key=lambda x: x.get("news_id", 0)
    )

    print(f"{len(items)} news item(s) on server")

    for item in items:

        text = (
            str(item.get("headline") or "")
            + " "
            + str(item.get("body") or "")
        )

        print_news(item, parse_news(text))


# --------------------------------------------------
# CAPM FUNCTIONS
# --------------------------------------------------

def get_exp_return(state, ticker, rm):

    return (
        state["rf"]
        + state["beta"][ticker] * (rm - state["rf"])
    )


def get_alpha(state, ticker, rm, y_observed):

    return y_observed - get_exp_return(state, ticker, rm)
