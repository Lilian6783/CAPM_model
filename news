import re

def news_section():

    old_news = list()

    def reset_news_reader():
        global old_news
        old_news = list()

    def gen_basedata_capm():
        return {
            "rf": "0.02",
            "rm": "0.08",
            "beta": {"AAA": 1.0, "BBB": 1.0, "CCC": 1.0}
        }

    def get_all_news(client):
        return client.get('/news', params={'limit': -1}).json()

    def extract_news(text):
        matches = re.findall(r'(-?\d+(?:\.\d+)?)\s*(%?)', text)
        if not matches:
            return None
        number, pct = matches[-1]
        return float(number) / 100 if pct else float(number)

    def news_analysis(news):
        headline = news.get("headline", "").lower()
        body = news.get("body", "")

        if "risk-free" in headline or "risk free" in headline:
            kind, ticker = "rf", None

        elif "market" in headline:
            kind, ticker = "rm", None

        elif "beta" in headline:
            kind, ticker = "beta", news.get("ticker")

        else:
            return (None, None, None)

    def is_new_news_in_mail(client):
        all_news = get_all_news(client)
        if len(all_news) == 0:
            return False
        return all_news[0] not in old_news

    def read_news(client, state):
        for news in get_all_news(client) [::-1]:
            if news in old_news:
                continue
            old_news.append(news)

            kind, ticker, value = news_analysis(news)
            if kind is None:
                continue

            if kind == "beta":
                state["beta"][ticker] = value

            else:
                state[kind] = value

            return state

    def get_exp_return(state, ticker):
        return state["rf"] + state["beta"][ticker]*(state["rm"] - state["rf"])

    def get_alpha(client, state, ticker, y_observed):
        return y_observed - get_exp_return(state, ticker)

print(get_alpha())
